#!/usr/bin/env bash
# Generated by tmux-remote. Do not edit by hand -- edit tmux-remote instead
# and rerun it to regenerate this file.
#
# Detaches every remote tmux session that tmux-remote attached for the
# given local session, then kills the local session itself (not just a
# detach -- there is nothing local left worth reattaching to once every
# remote window has been kicked back to an ssh prompt).
set -uo pipefail

if [[ $# -ne 1 || -z "$1" ]]; then
    echo "Usage: $0 <local-session-name>" >&2
    exit 1
fi

LOCAL_SESSION="$1"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-remote"
STATE_FILE="$STATE_DIR/$LOCAL_SESSION"

if [[ -f "$STATE_FILE" ]]; then
    while IFS=$'\t' read -r host session; do
        [[ -z "$host" || -z "$session" ]] && continue
        printf -v remote_cmd 'tmux detach-client -s %q' "$session"
        ssh -o ConnectTimeout=5 -o BatchMode=yes "$host" "$remote_cmd" \
            >/dev/null 2>&1 &
    done < "$STATE_FILE"
    wait
    rm -f "$STATE_FILE"
fi

tmux kill-session -t "$LOCAL_SESSION"
