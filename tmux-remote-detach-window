#!/usr/bin/env bash
# Generated by tmux-remote. Do not edit by hand -- edit tmux-remote instead
# and rerun it to regenerate this file.
#
# Detaches only the remote tmux session behind the given window, closes
# that window, and leaves other windows, remotes, and the local session
# attached.
set -uo pipefail

if [[ $# -ne 2 || -z "$1" || -z "$2" ]]; then
    echo "Usage: $0 <local-session-name> <window-name>" >&2
    exit 1
fi

LOCAL_SESSION="$1"
WINDOW="$2"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-remote"
STATE_FILE="$STATE_DIR/$LOCAL_SESSION"

[[ -f "$STATE_FILE" ]] || exit 0

HOST="$(awk -F'\t' -v s="$WINDOW" '$2 == s { print $1; exit }' "$STATE_FILE")"
[[ -n "$HOST" ]] || exit 0

printf -v remote_cmd 'tmux detach-client -s %q' "$WINDOW"
ssh -o ConnectTimeout=5 -o BatchMode=yes "$HOST" "$remote_cmd" >/dev/null 2>&1

tmux kill-window -t "${LOCAL_SESSION}:${WINDOW}"
