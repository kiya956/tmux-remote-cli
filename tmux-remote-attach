#!/usr/bin/env bash
# Generated by tmux-remote. Do not edit by hand -- edit tmux-remote instead
# and rerun it to regenerate this file.
#
# Attaches to one specific, already-existing remote tmux session as a new
# window in the current local session. If <ssh-host> is omitted, it is
# inferred from this local session's known remote hosts, provided there
# is exactly one.
set -uo pipefail

if [[ $# -eq 1 && -n "$1" ]]; then
    HOST=""
    SESSION="$1"
elif [[ $# -eq 2 && -n "$1" && -n "$2" ]]; then
    HOST="$1"
    SESSION="$2"
else
    echo "Usage: $0 [ssh-host] <remote-session-name>" >&2
    exit 1
fi

if [[ -z "${TMUX:-}" ]]; then
    echo "Run this from inside a local tmux session (start one with tmux-remote)." >&2
    exit 1
fi

LOCAL_SESSION="$(tmux display-message -p '#S')"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-remote"
STATE_FILE="$STATE_DIR/$LOCAL_SESSION"
mkdir -p "$STATE_DIR"

if [[ -z "$HOST" ]]; then
    # bash 3.2 (shipped by macOS) lacks `mapfile`; read the hosts by hand.
    known_hosts=()
    while IFS= read -r known_host; do
        [[ -n "$known_host" ]] && known_hosts+=("$known_host")
    done < <(awk -F'\t' '{print $1}' "$STATE_FILE" 2>/dev/null | sort -u)
    case "${#known_hosts[@]}" in
        0)
            echo "No known remote host yet for this session -- run 'tmux-remote <host>' first, or pass one explicitly: $0 <host> <session>" >&2
            exit 1
            ;;
        1)
            HOST="${known_hosts[0]}"
            ;;
        *)
            echo "Multiple remote hosts known for this session (${known_hosts[*]}) -- pass one explicitly: $0 <host> <session>" >&2
            exit 1
            ;;
    esac
fi

if tmux list-windows -t "$LOCAL_SESSION" -F '#W' | grep -Fxq "$SESSION"; then
    echo "Window '$SESSION' already exists in this local session." >&2
    exit 0
fi

printf -v remote_cmd 'tmux attach-session -t %q' "$SESSION"
printf -v launcher 'ssh -t %q %q; exec "${SHELL:-/bin/sh}"' "$HOST" "$remote_cmd"
printf -v cmd 'exec /bin/bash -c %q' "$launcher"

tmux new-window -t "$LOCAL_SESSION:" -n "$SESSION" "$cmd"

printf '%s\t%s\n' "$HOST" "$SESSION" >> "$STATE_FILE"
sort -u -o "$STATE_FILE" "$STATE_FILE"
